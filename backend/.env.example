# ---------- Server ----------
PORT=3000
NODE_ENV=development

# ---------- MySQL (never commit the real .env) ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=batloung_farm
DB_CONNECTION_LIMIT=10

# ---------- Administrator login ----------
# Set AUTH_ENABLED=false only while testing in Postman without a token.
AUTH_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_strong_password
JWT_SECRET=replace_with_a_long_random_secret
TOKEN_HOURS=8

# ---------- Business rules ----------
DEFAULT_PAYMENT_TERMS_DAYS=14
NEAR_EXPIRY_DAYS=3

# ---------- Business details printed on invoices ----------
BUSINESS_NAME=Batloung Farm
BUSINESS_ADDRESS=Industrial Area, Maseru, Lesotho
BUSINESS_PHONE=+266 2231 0000
BUSINESS_EMAIL=sales@batloungfarm.co.ls
